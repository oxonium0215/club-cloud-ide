[Unit]
Description=Club Cloud IDE Portal (OIDC SSO + LXD + 2-button entry)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/club-cloud-ide
Environment=OIDC_CLIENT_SECRET=osgsuken-portal-secret
Environment=REPO_URL=https://github.com/oxonium0215/club-cloud-ide.git
ExecStart=/opt/club-cloud-ide/bin/osgsuken-portal
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
