[Unit]
Description=Club Cloud IDE Portal (2-button entry)
After=osgsuken-coder.service
Requires=osgsuken-coder.service

[Service]
Type=simple
User=yugo
Environment=CODER_URL=http://localhost:7081
WorkingDirectory=/opt/club-cloud-ide
ExecStart=/usr/bin/env node scripts/portal.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
