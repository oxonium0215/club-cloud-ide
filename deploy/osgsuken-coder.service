[Unit]
Description=Club Cloud IDE Coder Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/coder/env
WorkingDirectory=/opt/club-cloud-ide
ExecStart=/usr/bin/coder server --config /etc/coder/coder.yaml
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
