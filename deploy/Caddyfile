# Caddy 設定 (ポータルのリバースプロキシ)
#
# 構成:
#   :7080 (Caddy) がすべての HTTP を受け、ポータル (Go) に認証を委譲する。
#   /proxy/<app>/<ip>/* はコンテナ内サービスへ転送する。
#
# 動的コンテナ IP:
#   LXD コンテナの IP は起動のたびに変わるため、ポータルの launch API が
#   /proxy/<app>/<ip> 形式の URL を返し、Caddy がパスから IP を抽出して転送する。
{
	admin off
	auto_https off
	# デバッグ用アクセスログ (本番では off に)
	log {
		output stdout
		format console
		level INFO
	}
}

:7080 {
	# --- 1. VS Code: /proxy/vscode/<ip>/* → <ip>:13337/* ---
	@vscode {
		path /proxy/vscode/*
	}
	handle @vscode {
		forward_auth 127.0.0.1:7081 {
			uri /auth/check
		}
		@vscode_upstream {
			path_regexp vscode_upstream ^/proxy/vscode/([0-9.]+)(/.*)?$
		}
		handle @vscode_upstream {
			uri strip_prefix /proxy/vscode/{re.vscode_upstream.1}
			reverse_proxy {re.vscode_upstream.1}:13337 {
				header_up X-Forwarded-Prefix /proxy/vscode
			}
		}
		respond "container not ready" 502
	}

	# --- 2. デスクトップ: /proxy/desktop/<ip>/* → <ip>:6080/* ---
	#    noVNC (websockify) はサブパスでの公開を前提とした作りで、
	#    接続先を vnc.html?path=... で指定できる。Caddy はパスを維持して転送する。
	@desktop {
		path /proxy/desktop/*
	}
	handle @desktop {
		# WebSocket (/websockify) は Cookie 存在チェックのみ
		@desktop_ws {
			path /proxy/desktop/*/websockify
		}
		@ws_no_cookie {
			not header Cookie *osgsuken_session*
		}
		handle @desktop_ws {
			handle @ws_no_cookie {
				respond "unauthorized" 401
			}
			@desktop_ws_upstream {
				path_regexp desktop_ws_upstream ^/proxy/desktop/([0-9.]+)(/.*)?$
			}
			handle @desktop_ws_upstream {
				uri strip_prefix /proxy/desktop/{re.desktop_ws_upstream.1}
				reverse_proxy {re.desktop_ws_upstream.1}:6080
			}
		}
		# 静的アセット (vnc.html 読み込み後の CSS/JS) は認証チェック不要
		@desktop_static {
			path /proxy/desktop/*/vnc.html
			path /proxy/desktop/*/vnc_lite.html
			path /proxy/desktop/*/app/*
			path /proxy/desktop/*/core/*
			path /proxy/desktop/*/vendor/*
			path /proxy/desktop/*/*.js
			path /proxy/desktop/*/*.css
			path /proxy/desktop/*/*.png
			path /proxy/desktop/*/*.svg
			path /proxy/desktop/*/*.woff*
			path /proxy/desktop/*/*.html
			path /proxy/desktop/*/favicon.ico
		}
		handle @desktop_static {
			@desktop_static_upstream {
				path_regexp desktop_static_upstream ^/proxy/desktop/([0-9.]+)(/.*)?$
			}
			handle @desktop_static_upstream {
				uri strip_prefix /proxy/desktop/{re.desktop_static_upstream.1}
				reverse_proxy {re.desktop_static_upstream.1}:6080
			}
		}
		# その他 (ルートなど) は認証チェック
		handle {
			forward_auth 127.0.0.1:7081 {
				uri /auth/check
			}
			@desktop_upstream {
				path_regexp desktop_upstream ^/proxy/desktop/([0-9.]+)(/.*)?$
			}
			handle @desktop_upstream {
				uri strip_prefix /proxy/desktop/{re.desktop_upstream.1}
				reverse_proxy {re.desktop_upstream.1}:6080
			}
			respond "container not ready" 502
		}
	}

	# --- 3. それ以外はポータル本体へ ---
	handle {
		reverse_proxy 127.0.0.1:7081
	}
}
