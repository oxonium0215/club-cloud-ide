[Unit]
Description=Club Cloud IDE Caddy (reverse proxy for portal & containers)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/club-cloud-ide
ExecStart=/usr/bin/caddy run --config /opt/club-cloud-ide/deploy/Caddyfile
ExecReload=/usr/bin/caddy reload --config /opt/club-cloud-ide/deploy/Caddyfile
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
